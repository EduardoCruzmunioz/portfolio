---
import { getCollection } from 'astro:content';
import { Github, ExternalLink } from 'lucide-react';

const projects = await getCollection('projects');
const sortedProjects = projects.sort((a, b) => a.data.order - b.data.order);

const categories = [
  { id: 'all', label: 'Todos' },
  { id: 'web', label: 'Web' },
  { id: 'mobile', label: 'Móvil' },
  { id: 'console', label: 'Consola' },
  { id: 'desktop', label: 'Escritorio' },
];

const baseClasses = 'filter-btn px-5 py-2.5 rounded-lg font-mono text-sm border transition-colors cursor-pointer';
const activeClasses = 'bg-foreground text-background border-foreground';
const inactiveClasses = 'bg-transparent text-muted-foreground border-border hover:border-foreground/50 hover:text-foreground';
---

<section id="projects" class="py-24">
  <div class="mb-12 flex flex-col md:flex-row md:items-end justify-between gap-6">
    <div>
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight mb-4">Proyectos Destacados</h2>
      <p class="text-lg text-muted-foreground max-w-2xl">
        Una selección de mis mejores trabajos, abarcando diferentes plataformas y tecnologías.
      </p>
    </div>
  </div>

  {/* Pestañas de filtrado */}
  <div class="flex flex-wrap items-center gap-3 mb-10">
    {categories.map(cat => (
      <button
        class={`${baseClasses} ${cat.id === 'all' ? activeClasses : inactiveClasses}`}
        data-filter={cat.id}
      >
        {cat.label}
      </button>
    ))}
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6" id="projects-grid">
    {sortedProjects.map(project => (
      <article class="project-card flex flex-col h-full bg-card rounded-2xl border border-border overflow-hidden hover:border-foreground/50 transition-colors" data-category={project.data.category}>
        <div class="p-6 md:p-8 flex flex-col h-full">
          <h3 class="text-2xl font-bold mb-3">{project.data.title}</h3>
          <p class="text-muted-foreground mb-6 line-clamp-3">
            {project.data.description}
          </p>
          
          <div class="flex flex-wrap gap-2 mb-8">
            {project.data.technologies.map(tech => (
              <span class="px-3 py-1 rounded-full bg-muted/50 text-sm font-medium text-muted-foreground">
                {tech}
              </span>
            ))}
          </div>

          <div class="flex items-center gap-4 pt-6 border-t border-border mt-auto">
            {project.data.githubUrl && (
              <a href={project.data.githubUrl} target="_blank" rel="noopener noreferrer" class="p-2.5 rounded-lg border border-border bg-muted/10 text-muted-foreground hover:text-foreground hover:border-foreground/50 transition-colors" aria-label="Ver código">
                <Github className="w-5 h-5" />
              </a>
            )}
            {project.data.liveUrl && (
              <a href={project.data.liveUrl} target="_blank" rel="noopener noreferrer" class="p-2.5 rounded-lg border border-border bg-muted/10 text-muted-foreground hover:text-foreground hover:border-foreground/50 transition-colors" aria-label="Visitar demo">
                <ExternalLink className="w-5 h-5" />
              </a>
            )}
            <a href={`/projects/${project.slug}`} class="ml-auto inline-flex items-center gap-2 px-5 py-2.5 bg-foreground text-background rounded-lg font-mono text-sm hover:opacity-90 transition-opacity">
              Leer caso -&gt;
            </a>
          </div>
        </div>
      </article>
    ))}

    {/* Mensaje de estado vacío (oculto por defecto) */}
    <div id="empty-state" class="hidden col-span-1 md:col-span-2 py-20 flex-col items-center justify-center text-center border border-dashed border-border rounded-2xl bg-muted/10">
      <p class="text-foreground font-mono text-lg mb-3">&lt;EmptyState /&gt;</p>
      <p class="text-muted-foreground max-w-md mx-auto">
        Todavía no he publicado proyectos en esta categoría, pero estoy trabajando en nuevas ideas y código. ¡Vuelve pronto!
      </p>
    </div>
  </div>
</section>

<script>
  // Lógica de filtrado en cliente
  const buttons = document.querySelectorAll('.filter-btn');
  const cards = document.querySelectorAll('.project-card') as NodeListOf<HTMLElement>;
  const emptyState = document.getElementById('empty-state');

  const baseClasses = 'filter-btn px-5 py-2.5 rounded-lg font-mono text-sm border transition-colors cursor-pointer';
  const activeClasses = 'bg-foreground text-background border-foreground';
  const inactiveClasses = 'bg-transparent text-muted-foreground border-border hover:border-foreground/50 hover:text-foreground';

  buttons.forEach(btn => {
    btn.addEventListener('click', () => {
      // 1. Resetear todos los botones a inactivo
      buttons.forEach(b => {
        b.className = `${baseClasses} ${inactiveClasses}`;
      });

      // 2. Poner el botón actual en activo
      btn.className = `${baseClasses} ${activeClasses}`;

      // 3. Filtrar tarjetas
      const filter = btn.getAttribute('data-filter');
      let visibleCount = 0;

      cards.forEach(card => {
        if (filter === 'all' || card.getAttribute('data-category') === filter) {
          card.style.display = 'flex'; // Las tarjetas usan flex-col
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      // 4. Mostrar u ocultar estado vacío
      if (emptyState) {
        if (visibleCount === 0) {
          emptyState.classList.remove('hidden');
          emptyState.classList.add('flex');
        } else {
          emptyState.classList.add('hidden');
          emptyState.classList.remove('flex');
        }
      }
    });
  });
</script>
