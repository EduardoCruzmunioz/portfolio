---
import Layout from '../layouts/Layout.astro';
import Header from '../components/ui/Header';
import { 
  Download, Briefcase, GraduationCap, Wrench, 
  Server, Code, Terminal, Mail, MapPin, User, HeartHandshake
} from 'lucide-react';
---

<Layout 
  title="CV - Eduardo Cruz | Desarrollador de Software" 
  description="Currículum Vitae de Eduardo Cruz Muñoz. Desarrollador de Software Multiplataforma (DAM) y Sistemas (SMR). Especialista en Java, TypeScript, React y Dart."
>
  <Header client:load />
  
  <main class="max-w-5xl mx-auto px-4 md:px-8 py-24 md:py-32">
    
    {/* Cabecera / Hero del CV */}
    <div class="flex flex-col md:flex-row gap-8 items-start justify-between mb-16 border-b border-border pb-12">
      <div class="flex flex-col sm:flex-row gap-6 items-center sm:items-start text-center sm:text-left">
        <img 
          src="/foto-eduardo.jpg" 
          alt="Eduardo Cruz" 
          class="w-32 h-32 rounded-2xl object-cover border border-border shadow-sm"
          onerror="this.src='https://ui-avatars.com/api/?name=Eduardo+Cruz&size=512&background=0D0D0D&color=fff'"
        />
        <div class="mt-2">
          <h1 class="text-4xl md:text-5xl font-bold tracking-tight mb-2 text-foreground">Eduardo Cruz Muñoz</h1>
          <h2 class="text-xl text-primary font-mono font-medium mb-5">Desarrollador de Software Multiplataforma & Web</h2>
          <div class="flex flex-wrap justify-center sm:justify-start gap-x-6 gap-y-3 text-sm text-muted-foreground">
            <a href="mailto:educruzm2004@gmail.com" class="flex items-center gap-2 hover:text-foreground transition-colors"><Mail className="w-4 h-4"/> educruzm2004@gmail.com</a>
            <span class="flex items-center gap-2"><MapPin className="w-4 h-4"/> Martos, Jaén</span>
            <a href="https://www.linkedin.com/in/eduardocruzdev/" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 hover:text-foreground transition-colors">LinkedIn: eduardocruzdev ↗</a>
            <a href="https://github.com/EduardoCruzmunioz" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 hover:text-foreground transition-colors">GitHub: EduardoCruzmunioz ↗</a>
          </div>
        </div>
      </div>
      
      <a href="/cv-eduardo-cruz.pdf" download class="shrink-0 w-full md:w-auto flex items-center justify-center gap-2 px-6 py-3 bg-foreground text-background rounded-lg font-mono text-sm hover:opacity-90 transition-opacity shadow-md">
        <Download className="w-4 h-4" /> Descargar PDF
      </a>
    </div>

    {/* Layout principal a dos columnas */}
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-12 lg:gap-16">
      
      {/* Columna Izquierda (Principal: Experiencia y Educación) */}
      <div class="lg:col-span-2 space-y-16">
        
        {/* Perfil */}
        <section>
          <h3 class="text-2xl font-bold mb-6 flex items-center gap-3 text-foreground">
            <User className="w-6 h-6 text-muted-foreground" /> Perfil Profesional
          </h3>
          <p class="text-muted-foreground leading-relaxed">
            Desarrollador de Software Multiplataforma (CFGS DAM) con sólida formación previa en Sistemas Microinformáticos y Redes (CFGM SMR). Especializado en la creación de software empresarial robusto en <strong class="text-foreground font-semibold">Java</strong>, arquitecturas web de alto rendimiento con <strong class="text-foreground font-semibold">TypeScript, React y Astro</strong>, y sistemas reactivos en tiempo real con <strong class="text-foreground font-semibold">Dart y Google Firebase</strong>.
          </p>
          <p class="text-muted-foreground leading-relaxed mt-3">
            Creador del software ERP oficial en producción para <strong class="text-foreground font-semibold">MiPC Martos</strong>. Mi experiencia previa en soporte técnico e infraestructura corporativa en multinacionales como <strong class="text-foreground font-semibold">Valeo SE</strong> y <strong class="text-foreground font-semibold">BOYCOR</strong> me aporta una <strong class="text-foreground font-semibold">visión 360°</strong> única: capacidad para diseñar arquitecturas de código limpias comprendiendo a fondo los servidores, las redes y la resolución de incidencias críticas en entornos reales.
          </p>
        </section>

        {/* Experiencia */}
        <section>
          <h3 class="text-2xl font-bold mb-8 flex items-center gap-3 text-foreground">
            <Briefcase className="w-6 h-6 text-muted-foreground" /> Experiencia Profesional & Desarrollo
          </h3>
          <div class="space-y-12 border-l-2 border-border pl-6 ml-3">
            
            {/* Desarrollo de Software */}
            <div class="relative group">
              <div class="absolute -left-[33px] top-1.5 w-4 h-4 rounded-full bg-background border-4 border-primary group-hover:border-foreground transition-colors"></div>
              <div class="flex flex-col sm:flex-row sm:justify-between sm:items-start mb-2 gap-2">
                <div>
                  <h4 class="text-lg font-bold text-foreground">Desarrollador de Software (Proyectos & Producción)</h4>
                  <p class="text-muted-foreground font-mono text-sm">MiPC Martos & Proyectos Independientes</p>
                </div>
                <span class="text-xs font-mono bg-muted border border-border text-foreground px-3 py-1 rounded-full whitespace-nowrap w-fit">2024 – Actualidad</span>
              </div>
              <ul class="space-y-3 mt-4 text-muted-foreground">
                <li class="flex items-start gap-3">
                  <span class="mt-2 w-1.5 h-1.5 rounded-full bg-foreground/30 shrink-0"></span>
                  <span class="text-sm leading-relaxed"><strong class="text-foreground font-semibold">ERP MiPC (Java 25, Swing, Maven):</strong> Desarrollo del software oficial de administración técnica para servicio informático en uso real. Módulos de recepción de equipos, presupuestación automatizada de mano de obra y trazabilidad completa de reparaciones.</span>
                </li>
                <li class="flex items-start gap-3">
                  <span class="mt-2 w-1.5 h-1.5 rounded-full bg-foreground/30 shrink-0"></span>
                  <span class="text-sm leading-relaxed"><strong class="text-foreground font-semibold">Sistema de Urgencias y Triaje (Dart, Firebase Firestore):</strong> Aplicación asistencial para clasificación de pacientes y disponibilidad médica en tiempo real con binario nativo empaquetado para Windows (.exe).</span>
                </li>
                <li class="flex items-start gap-3">
                  <span class="mt-2 w-1.5 h-1.5 rounded-full bg-foreground/30 shrink-0"></span>
                  <span class="text-sm leading-relaxed"><strong class="text-foreground font-semibold">Gym Management RESTful API (TypeScript, Node.js, Express 5):</strong> Backend modular bajo arquitectura en 3 capas desacoplada con middlewares de seguridad (Helmet), caché en memoria (apicache) y especificación interactiva OpenAPI/Swagger.</span>
                </li>
              </ul>
            </div>

            {/* BOYCOR */}
            <div class="relative group">
              <div class="absolute -left-[33px] top-1.5 w-4 h-4 rounded-full bg-background border-4 border-muted-foreground group-hover:border-foreground transition-colors"></div>
              <div class="flex flex-col sm:flex-row sm:justify-between sm:items-start mb-2 gap-2">
                <div>
                  <h4 class="text-lg font-bold text-foreground">Técnico de Soporte Informático (Help Desk N1/N2)</h4>
                  <p class="text-muted-foreground font-mono text-sm">BOYCOR</p>
                </div>
                <span class="text-xs font-mono bg-muted border border-border text-foreground px-3 py-1 rounded-full whitespace-nowrap w-fit">Junio 2024 – Julio 2024</span>
              </div>
              <ul class="space-y-3 mt-4 text-muted-foreground">
                <li class="flex items-start gap-3">
                  <span class="mt-2 w-1.5 h-1.5 rounded-full bg-foreground/30 shrink-0"></span>
                  <span class="text-sm leading-relaxed">Atención técnica de primer y segundo nivel para usuarios corporativos, diagnosticando problemas en equipos informáticos y asegurando la continuidad operativa.</span>
                </li>
                <li class="flex items-start gap-3">
                  <span class="mt-2 w-1.5 h-1.5 rounded-full bg-foreground/30 shrink-0"></span>
                  <span class="text-sm leading-relaxed">Despliegue y configuración de hardware y software en puestos de trabajo, aplicación de protocolos de seguridad y respaldo de datos.</span>
                </li>
              </ul>
            </div>

            {/* VALEO */}
            <div class="relative group">
              <div class="absolute -left-[33px] top-1.5 w-4 h-4 rounded-full bg-background border-4 border-muted-foreground group-hover:border-foreground transition-colors"></div>
              <div class="flex flex-col sm:flex-row sm:justify-between sm:items-start mb-2 gap-2">
                <div>
                  <h4 class="text-lg font-bold text-foreground">Técnico de Soporte Informático & Sistemas</h4>
                  <p class="text-muted-foreground font-mono text-sm">Valeo SE (Multinacional Automoción)</p>
                </div>
                <span class="text-xs font-mono bg-muted border border-border text-foreground px-3 py-1 rounded-full whitespace-nowrap w-fit">Marzo 2024 – Junio 2024</span>
              </div>
              <ul class="space-y-3 mt-4 text-muted-foreground">
                <li class="flex items-start gap-3">
                  <span class="mt-2 w-1.5 h-1.5 rounded-full bg-foreground/30 shrink-0"></span>
                  <span class="text-sm leading-relaxed">Gestión y resolución de incidencias en entorno corporativo industrial mediante el sistema de ticketing <strong class="text-foreground font-semibold">Jira</strong>.</span>
                </li>
                <li class="flex items-start gap-3">
                  <span class="mt-2 w-1.5 h-1.5 rounded-full bg-foreground/30 shrink-0"></span>
                  <span class="text-sm leading-relaxed">Administración de usuarios, permisos y credenciales mediante <strong class="text-foreground font-semibold">Active Directory</strong> y soporte remoto con <strong class="text-foreground font-semibold">BeyondTrust</strong>.</span>
                </li>
                <li class="flex items-start gap-3">
                  <span class="mt-2 w-1.5 h-1.5 rounded-full bg-foreground/30 shrink-0"></span>
                  <span class="text-sm leading-relaxed">Diagnóstico de redes TCP/IP locales y mantenimiento de estabilidad en infraestructura Wi-Fi de planta y oficinas.</span>
                </li>
              </ul>
            </div>

          </div>
        </section>

        {/* Formación */}
        <section>
          <h3 class="text-2xl font-bold mb-8 flex items-center gap-3 text-foreground">
            <GraduationCap className="w-6 h-6 text-muted-foreground" /> Formación Académica & Certificaciones
          </h3>
          <div class="space-y-8 border-l-2 border-border pl-6 ml-3">
            
            <div class="relative group">
              <div class="absolute -left-[33px] top-1.5 w-4 h-4 rounded-full bg-background border-4 border-muted-foreground group-hover:border-foreground transition-colors"></div>
              <h4 class="text-lg font-bold text-foreground">Desarrollo Front-end con React</h4>
              <p class="text-muted-foreground font-mono text-sm mt-1">OpenWebinars <span class="mx-2 opacity-50">•</span> 2025</p>
            </div>
            
            <div class="relative group">
              <div class="absolute -left-[33px] top-1.5 w-4 h-4 rounded-full bg-background border-4 border-primary group-hover:border-foreground transition-colors"></div>
              <h4 class="text-lg font-bold text-foreground leading-tight">CFGS Desarrollo de Aplicaciones Multiplataforma (DAM)</h4>
              <p class="text-muted-foreground font-mono text-sm mt-1">IES Fernando III <span class="mx-2 opacity-50">•</span> 2024 – En curso</p>
            </div>

            <div class="relative group">
              <div class="absolute -left-[33px] top-1.5 w-4 h-4 rounded-full bg-background border-4 border-muted-foreground group-hover:border-foreground transition-colors"></div>
              <h4 class="text-lg font-bold text-foreground leading-tight">CFGM Sistemas Microinformáticos y Redes (SMR)</h4>
              <p class="text-muted-foreground font-mono text-sm mt-1">IES Miguel Sánchez López <span class="mx-2 opacity-50">•</span> 2022 – 2024</p>
            </div>

          </div>
        </section>

        {/* Voluntariado */}
        <section>
          <h3 class="text-2xl font-bold mb-6 flex items-center gap-3 text-foreground">
            <HeartHandshake className="w-6 h-6 text-muted-foreground" /> Voluntariado & Competencias Personales
          </h3>
          <div class="bg-muted/30 p-6 rounded-xl border border-border">
            <div class="flex justify-between items-start mb-2">
              <h4 class="font-bold text-foreground">Voluntario Operativo en Emergencias</h4>
              <span class="text-xs font-mono bg-muted border border-border text-foreground px-3 py-1 rounded-full">Activo</span>
            </div>
            <p class="text-muted-foreground font-mono text-sm mb-3">Agrupación Local de Protección Civil de Martos</p>
            <p class="text-sm text-muted-foreground leading-relaxed">
              Participación activa en dispositivos preventivos y coordinación logística en situaciones críticas. Desarrollo demostrado de templanza bajo presión, resolución ágil de imprevistos, empatía en la atención ciudadana y trabajo coordinado en equipo.
            </p>
          </div>
        </section>

      </div>

      {/* Columna Derecha (Secundaria: Skills e Info) */}
      <div class="lg:col-span-1 space-y-10">
        
        <section>
          <h3 class="text-2xl font-bold mb-6 flex items-center gap-3 text-foreground">
            <Wrench className="w-6 h-6 text-muted-foreground" /> Stack Técnico
          </h3>

          <div class="space-y-4">
            
            {/* Desarrollo */}
            <div class="bg-muted/30 p-5 rounded-xl border border-border hover:border-foreground/30 transition-colors">
              <h4 class="font-bold flex items-center gap-2 mb-4 text-foreground">
                <Code className="w-4 h-4 text-primary"/> Desarrollo & Software
              </h4>
              <div class="flex flex-wrap gap-2">
                {['Java 25', 'TypeScript', 'JavaScript', 'Dart', 'React', 'Astro', 'Node.js', 'Express', 'Tailwind CSS', 'C++', 'Python'].map((skill) => (
                  <span class="px-2.5 py-1 bg-background border border-border rounded-md text-xs font-mono text-foreground font-medium shadow-sm">{skill}</span>
                ))}
              </div>
            </div>

            {/* Bases de datos & Cloud */}
            <div class="bg-muted/30 p-5 rounded-xl border border-border hover:border-foreground/30 transition-colors">
              <h4 class="font-bold flex items-center gap-2 mb-4 text-foreground">
                <Server className="w-4 h-4 text-muted-foreground"/> Datos & Cloud
              </h4>
              <div class="flex flex-wrap gap-2">
                {['Firebase Firestore', 'MySQL', 'PostgreSQL', 'MongoDB'].map((skill) => (
                  <span class="px-2.5 py-1 bg-background border border-border rounded-md text-xs font-mono text-muted-foreground shadow-sm">{skill}</span>
                ))}
              </div>
            </div>

            {/* Sistemas (El valor 360°) */}
            <div class="bg-muted/30 p-5 rounded-xl border border-border hover:border-foreground/30 transition-colors">
              <h4 class="font-bold flex items-center gap-2 mb-4 text-foreground">
                <Server className="w-4 h-4 text-muted-foreground"/> Infraestructura & Sistemas
              </h4>
              <div class="flex flex-wrap gap-2">
                {['Ubuntu Server', 'Linux', 'Windows Server', 'Active Directory', 'Redes TCP/IP', 'BeyondTrust', 'Jira'].map((skill) => (
                  <span class="px-2.5 py-1 bg-background border border-border rounded-md text-xs font-mono text-muted-foreground shadow-sm">{skill}</span>
                ))}
              </div>
            </div>

            {/* Herramientas */}
            <div class="bg-muted/30 p-5 rounded-xl border border-border hover:border-foreground/30 transition-colors">
              <h4 class="font-bold flex items-center gap-2 mb-4 text-foreground">
                <Terminal className="w-4 h-4 text-muted-foreground"/> Metodología & Herramientas
              </h4>
              <div class="flex flex-wrap gap-2">
                {['Git & GitHub', 'Clean Architecture', 'RESTful APIs', 'Maven', 'Swagger / OpenAPI'].map((skill) => (
                  <span class="px-2.5 py-1 bg-background border border-border rounded-md text-xs font-mono text-muted-foreground shadow-sm">{skill}</span>
                ))}
              </div>
            </div>

          </div>
        </section>

        {/* Info Adicional */}
        <section>
          <h3 class="text-xl font-bold mb-4 border-b border-border pb-2 text-foreground">Info Adicional</h3>
          <ul class="space-y-4 text-sm text-muted-foreground">
            <li class="flex flex-col gap-1">
              <strong class="text-foreground">Idiomas</strong> 
              <span class="font-mono text-xs">Español (Nativo) · Inglés técnico (documentación y código).</span>
            </li>
            <li class="flex flex-col gap-1">
              <strong class="text-foreground">Carnet de conducir</strong> 
              <span class="font-mono text-xs">Clase B (Vehículo propio)</span>
            </li>
            <li class="flex flex-col gap-1">
              <strong class="text-foreground">Disponibilidad</strong> 
              <span class="font-mono text-xs">Inmediata para proyectos, prácticas o incorporación laboral.</span>
            </li>
          </ul>
        </section>

      </div>

    </div>
  </main>
</Layout>
