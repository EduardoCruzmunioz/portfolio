---
import Layout from '../layouts/Layout.astro';
import Header from '../components/ui/Header';
import { 
  Download, Mail, MapPin, FileText
} from 'lucide-react';
---

<Layout 
  title="CV - Eduardo Cruz | Soporte IT & Dev Junior" 
  description="Currículum Vitae de Eduardo Cruz. Técnico Superior en Desarrollo de Aplicaciones Multiplataforma (DAM) y Sistemas (SMR)."
>
  <Header client:load />
  
  <main class="max-w-5xl mx-auto px-4 md:px-8 py-24 md:py-32">
    
    {/* Cabecera / Hero del CV */}
    <div class="flex flex-col md:flex-row gap-8 items-start justify-between mb-12 border-b border-border pb-12">
      <div class="flex flex-col sm:flex-row gap-6 items-center sm:items-start text-center sm:text-left">
        <img 
          src="/foto-eduardo.jpg" 
          alt="Eduardo Cruz" 
          class="w-32 h-32 rounded-2xl object-cover border border-border shadow-sm"
          onerror="this.src='https://ui-avatars.com/api/?name=Eduardo+Cruz&size=512&background=0D0D0D&color=fff'"
        />
        <div class="mt-2">
          <h1 class="text-4xl md:text-5xl font-bold tracking-tight mb-2 text-foreground">Eduardo Cruz Muñoz</h1>
          <h2 class="text-xl text-muted-foreground font-mono mb-5">Técnico de Soporte IT | Desarrollador Junior</h2>
          <div class="flex flex-wrap justify-center sm:justify-start gap-x-6 gap-y-3 text-sm text-muted-foreground">
            <a href="mailto:educruzm2004@gmail.com" class="flex items-center gap-2 hover:text-foreground transition-colors"><Mail className="w-4 h-4"/> educruzm2004@gmail.com</a>
            <span class="flex items-center gap-2"><MapPin className="w-4 h-4"/> Martos, Jaén</span>
          </div>
        </div>
      </div>
      
      <a href="/cv-eduardo-cruz.pdf" download class="shrink-0 w-full md:w-auto flex items-center justify-center gap-2 px-6 py-3 bg-foreground text-background rounded-lg font-mono text-sm hover:opacity-90 transition-opacity shadow-md">
        <Download className="w-4 h-4" /> Descargar PDF
      </a>
    </div>

    {/* Resumen Breve */}
    <div class="max-w-3xl mx-auto text-center mb-16">
      <p class="text-muted-foreground leading-relaxed text-lg">
        Técnico en Sistemas Microinformáticos y Redes con experiencia en soporte y administración de sistemas. 
        Actualmente cursando DAM para especializarme en desarrollo de software, combinando así la infraestructura 
        física con el desarrollo lógico multiplataforma.
      </p>
    </div>

    {/* Visualizador de PDF */}
    <div class="flex flex-col items-center">
      <div class="w-full flex items-center justify-between mb-4 px-2">
        <h3 class="text-xl font-bold flex items-center gap-2 text-foreground">
          <FileText className="w-5 h-5"/> Visualización del Documento
        </h3>
      </div>
      
      <div class="w-full h-[80vh] min-h-[600px] rounded-xl overflow-hidden border border-border bg-muted/30 shadow-lg relative">
        <object data="/cv-eduardo-cruz.pdf" type="application/pdf" class="w-full h-full">
          {/* Fallback si el navegador no puede mostrar PDFs (ej. algunos móviles) */}
          <div class="flex flex-col items-center justify-center h-full p-8 text-center bg-card">
            <FileText className="w-16 h-16 text-muted-foreground mb-4 opacity-50"/>
            <p class="mb-6 text-foreground font-medium">Tu navegador no soporta la previsualización directa de PDFs.</p>
            <a href="/cv-eduardo-cruz.pdf" download class="inline-flex items-center gap-2 px-6 py-3 bg-foreground text-background rounded-lg font-mono text-sm hover:opacity-90 transition-opacity">
              <Download className="w-4 h-4" /> Descargar el Currículum
            </a>
          </div>
        </object>
      </div>
    </div>

  </main>
</Layout>
