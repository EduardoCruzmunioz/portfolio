---
import Layout from '../layouts/Layout.astro';
import Header from '../components/ui/Header';
import Skills from '../components/sections/Skills.astro';
import Projects from '../components/sections/Projects.astro';
---

<Layout
  title="Eduardo Cruz | Desarrollador FullStack"
  description="Portfolio de Eduardo Cruz, Técnico FullStack en Martos, Jaén. Construyo aplicaciones web completas prestando especial atención al rendimiento y la escalabilidad."
>
  <Header client:load />

  <main class="max-w-6xl mx-auto px-4 md:px-6">
    
    {/* ===== HERO SECTION ===== */}
    <section id="about" class="pt-16 pb-20 md:pt-24 md:pb-32 flex flex-col-reverse lg:flex-row items-center justify-between gap-16 lg:gap-8">
      
      {/* Columna de Texto */}
      <div class="flex-1 flex flex-col items-start">
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full border border-border bg-muted/50 text-muted-foreground text-xs md:text-sm font-mono mb-8 w-fit">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-green-500"></span>
          </span>
          Disponible para nuevos retos
        </div>
        
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight mb-8">
          Desarrollador <span class="text-muted-foreground">FullStack.</span><br/>
          Construyendo <br class="hidden lg:block" />
          arquitecturas sólidas.
        </h1>
        
        <p class="text-lg md:text-xl text-muted-foreground max-w-2xl leading-relaxed mb-10">
          Técnico Superior en Desarrollo Multiplataforma (DAM) y Sistemas (SMR) desde Martos, Jaén. Construyo software eficiente y escalable dominando todo el proceso: desde la configuración del servidor y bases de datos, hasta el desarrollo backend y frontend.
        </p>

        <div class="flex flex-wrap items-center gap-4">
          <a href="#projects" class="bg-foreground text-background px-6 py-3 rounded-lg font-mono hover:opacity-90 transition-opacity">
            Ver Proyectos
          </a>
          <a href="#skills" class="border border-border bg-transparent hover:bg-muted text-foreground px-6 py-3 rounded-lg font-mono transition-colors">
            Explorar Skills
          </a>
        </div>
      </div>

      {/* Columna de Imagen (Foto de Perfil) */}
      <div class="w-48 h-48 md:w-56 md:h-56 lg:w-[260px] lg:h-[260px] relative flex-shrink-0 group mx-auto lg:mx-0">
        <div class="absolute inset-0 border-2 border-foreground/15 rounded-3xl translate-x-4 translate-y-4 group-hover:translate-x-2 group-hover:translate-y-2 transition-transform duration-500 -z-10"></div>
        <div class="w-full h-full rounded-3xl overflow-hidden border border-border bg-muted relative">
          <img 
            src="/foto-eduardo.jpg" 
            alt="Eduardo Cruz" 
            class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-500"
            onerror="this.src='https://ui-avatars.com/api/?name=Eduardo+Cruz&size=512&background=0D0D0D&color=fff'"
          />
        </div>
      </div>

    </section>

    {/* ===== SKILLS SECTION ===== */}
    <Skills />

    {/* ===== PROJECTS SECTION ===== */}
    <Projects />

    {/* ===== CONTACT / CTA SECTION ===== */}
    <section id="contact" class="py-32 border-t border-border flex flex-col items-center text-center">
      <h2 class="text-4xl md:text-5xl font-bold tracking-tight mb-6">¿Trabajamos juntos?</h2>
      <p class="text-xl text-muted-foreground max-w-xl mb-10">
        Actualmente estoy abierto a nuevas oportunidades. Si tienes un proyecto en mente o quieres saludar, mi bandeja de entrada está siempre abierta.
      </p>
      <a href="mailto:educruzm2004@gmail.com" class="bg-foreground text-background px-8 py-4 rounded-xl font-mono text-lg hover:opacity-90 transition-opacity active:scale-95">
        Ponerse en contacto
      </a>
    </section>

  </main>
  
  {/* ===== FOOTER ===== */}
  <footer class="py-10 border-t border-border flex flex-col items-center justify-center text-muted-foreground text-sm font-mono text-center px-4">
    <p>Construido con Astro, React y Tailwind CSS.</p>
    <p class="mt-2">&copy; {new Date().getFullYear()} Eduardo Cruz.</p>
  </footer>
</Layout>
